{
  "name": "kangkangpet",
  "version": "1.0.10",
  "description": "FORCOME AI CLI 桌面伴侣：单托盘、康康熊桌宠、本地日程提醒与便利贴。",
  "main": "main.js",
  "scripts": {
    "prestart": "node scripts/process-pet-assets.js",
    "start": "electron .",
    "test": "node --test",
    "check": "node --check main.js && node --check src/main/reminders.js && node --check src/main/reminder-scheduler.js && node --check src/main/config-store.js && node --check src/main/employee-policy.js && node --check src/main/notes-store.js && node --check src/main/pwa-launcher.js && node --check src/main/forcome-cli.js && node --check src/main/holiday-service.js && node --check src/main/us-holiday-service.js && node --check src/main/productivity-tools.js && node --check src/main/window-layout.js && node --check src/main/logger.js && node --check src/main/migration.js && node --check src/main/reminder-backup.js",
    "export:domain-reminders": "python scripts/export-domain-reminders.py",
    "smoke": "node scripts/smoke-check.js",
    "prepack": "node scripts/process-pet-assets.js",
    "pack": "electron-builder --dir",
    "predist": "node scripts/process-pet-assets.js",
    "dist": "electron-builder --win nsis",
    "build:exe": "powershell -ExecutionPolicy Bypass -File .\\scripts\\build-exe.ps1",
    "cert:generate": "powershell -ExecutionPolicy Bypass -File .\\scripts\\generate-code-sign-cert.ps1"
  },
  "keywords": [
    "electron",
    "desktop-pet",
    "windows",
    "desktop-pet"
  ],
  "author": "Linus359",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Linus359/kangkangpet.git"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "electron": "^39.8.5",
    "electron-builder": "^24.13.3",
    "sharp": "^0.33.5"
  },
  "build": {
    "appId": "com.forcome.kangkangpet",
    "productName": "康康熊桌宠",
    "copyright": "Copyright © 2026 Linus359",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "pet.html",
      "panel.html",
      "quick-reminder.html",
      "note.html",
      "preload/**/*",
      "src/main/**/*",
      "assets/config/**/*",
      "package.json",
      "assets/cat-processed/**/*",
      "assets/head/**/*",
      "!**/*.map",
      "!node_modules/exceljs/dist/**/*"
    ],
    "asar": true,
    "compression": "maximum",
    "electronLanguages": [
      "zh-CN"
    ],
    "asarUnpack": [
      "assets/cat-processed/**",
      "assets/head/**"
    ],
    "extraResources": [
      {
        "from": "dist/cli/runtime",
        "to": "forcome-cli/runtime"
      },
      {
        "from": "dist/cli/cli",
        "to": "forcome-cli/cli"
      },
      {
        "from": "dist/cli/bin",
        "to": "forcome-cli/bin"
      },
      {
        "from": "dist/cli/ForcomeAiTray.exe",
        "to": "forcome-cli/ForcomeAiTray.exe"
      },
      {
        "from": "dist/cli/assets",
        "to": "forcome-cli/assets"
      }
    ],
    "publish": {
      "provider": "github",
      "owner": "Linus359",
      "repo": "kangkangpet"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "dist/cli/assets/forcome.ico",
      "artifactName": "kangkangpet-setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "康康熊桌宠",
      "menuCategory": "康康熊桌宠",
      "uninstallDisplayName": "康康熊桌宠",
      "installerIcon": "dist/cli/assets/forcome.ico",
      "uninstallerIcon": "dist/cli/assets/forcome.ico",
      "installerHeaderIcon": "dist/cli/assets/forcome.ico",
      "language": "2052",
      "runAfterFinish": true,
      "deleteAppDataOnUninstall": false,
      "include": "build/installer.nsh"
    }
  }
}
